{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/air-fryer/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/air-fryer/admin/index.html"
    },
    {
      "destination": "/air-fryer/index.html",
      "source": "/"
    }
  ],
  "buildCommand": "node scripts/build.mjs"
}
